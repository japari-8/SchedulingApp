<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="750.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="aparicio.controller.Reports">
   <children>
      <VBox prefHeight="750.0" prefWidth="1000.0">
         <children>
            <HBox prefHeight="70.0" prefWidth="200.0">
               <children>
                  <Label text="Reports">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font></Label>
               </children></HBox>
            <HBox alignment="CENTER" prefHeight="46.0" prefWidth="200.0">
               <children>
                  <Label text="Total # of customer appointments by month and type" />
               </children>
            </HBox>
            <HBox alignment="TOP_CENTER" prefHeight="100.0" prefWidth="200.0" spacing="20.0">
               <children>
                  <ComboBox prefWidth="150.0" promptText="month" />
                  <ComboBox prefWidth="150.0" promptText="type" />
                  <TextField editable="false" promptText="# of appointments" />
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="46.0" prefWidth="200.0">
               <children>
                  <Label text="Schedule for Contact" />
               </children>
            </HBox>
            <HBox alignment="TOP_CENTER" prefHeight="40.0" prefWidth="200.0">
               <children>
                  <ComboBox prefWidth="150.0" promptText="Contact" />
               </children>
            </HBox>
            <HBox prefHeight="230.0" prefWidth="200.0">
               <children>
                  <TableView fx:id="appntTableView" prefHeight="240.0" prefWidth="980.0">
                     <columns>
                        <TableColumn fx:id="AppntCol" prefWidth="100.0" text="Appointment ID" />
                        <TableColumn fx:id="titleCol" prefWidth="100.0" text="Tittle" />
                        <TableColumn fx:id="descriptionCol" prefWidth="100.0" text="Description" />
                        <TableColumn fx:id="locationCol" prefWidth="100.0" text="Location" />
                        <TableColumn fx:id="typeCol" prefWidth="100.0" text="Type" />
                        <TableColumn fx:id="startDateTimeCol" prefWidth="127.0" text="Start Date/Time" />
                        <TableColumn fx:id="endDateTimeCol" prefWidth="128.0" text="End Date/Time" />
                        <TableColumn fx:id="customerIdCol2" minWidth="0.0" prefWidth="75.0" text="Customer ID" />
                        <TableColumn fx:id="userIdCol" minWidth="0.0" prefWidth="75.0" text="User Id" />
                        <TableColumn fx:id="contactIdCol" prefWidth="75.0" text="Contact ID" />
                     </columns>
                  </TableView>
               </children>
            </HBox>
            <HBox alignment="BOTTOM_CENTER" prefHeight="85.0" prefWidth="979.0">
               <children>
                  <Label text="Total # of appointments in the same location" />
               </children>
            </HBox>
            <HBox alignment="TOP_CENTER" prefHeight="100.0" prefWidth="200.0" spacing="20.0">
               <children>
                  <ComboBox prefWidth="150.0" promptText="location" />
                  <TextField promptText="# of appointments" />
               </children>
               <padding>
                  <Insets top="15.0" />
               </padding>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding></VBox>
   </children>
</AnchorPane>
