<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="550.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="aparicio.controller.UpdateCustomer">
   <children>
      <VBox prefHeight="550.0" prefWidth="700.0">
         <children>
            <Label alignment="TOP_LEFT" text="Update Customer Record" textFill="#215f9a">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
               <padding>
                  <Insets bottom="60.0" left="40.0" right="20.0" top="40.0" />
               </padding>
            </Label>
            <GridPane alignment="CENTER" prefHeight="304.0" prefWidth="700.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="20.0">
                     <children>
                        <TextField fx:id="firstNameUpdate" maxWidth="300.0" opacity="0.8" prefHeight="35.0" prefWidth="285.0" promptText="First name">
                           <opaqueInsets>
                              <Insets />
                           </opaqueInsets>
                        </TextField>
                        <TextField fx:id="lastNameUpdate" layoutX="10.0" layoutY="10.0" maxWidth="300.0" opacity="0.8" prefHeight="35.0" prefWidth="285.0" promptText="Last name" />
                     </children>
                     <padding>
                        <Insets left="40.0" right="40.0" />
                     </padding>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" GridPane.rowIndex="1">
                     <children>
                        <TextField fx:id="addressUpdate" opacity="0.8" prefHeight="35.0" prefWidth="590.0" promptText="Address" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="20.0" GridPane.rowIndex="2">
                     <children>
                        <TextField opacity="0.8" prefHeight="35.0" prefWidth="285.0" promptText="State/Province" />
                        <TextField opacity="0.8" prefHeight="35.0" prefWidth="285.0" promptText="Country" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="20.0" GridPane.rowIndex="3">
                     <children>
                        <TextField fx:id="postalCodeUpdate" opacity="0.8" prefHeight="35.0" prefWidth="183.0" promptText="Postal Code" />
                        <TextField fx:id="phoneNumUpdate" layoutX="10.0" layoutY="10.0" opacity="0.8" prefHeight="35.0" prefWidth="183.0" promptText="Phone #" />
                        <TextField fx:id="updateCustomerId" editable="false" layoutX="159.0" layoutY="10.0" opacity="0.8" prefHeight="35.0" prefWidth="183.0" />
                     </children>
                  </HBox>
               </children>
            </GridPane>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="40.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onSaveUpdateCustomer" prefHeight="35.0" prefWidth="60.0" text="SAVE">
                     <effect>
                        <ColorAdjust />
                     </effect>
                  </Button>
                  <Button layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#onCancelUpdateCustomer" prefHeight="35.0" prefWidth="60.0" text="CANCEL" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
